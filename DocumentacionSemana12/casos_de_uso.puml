@startuml CasosDeUso_RoomTracker

skinparam actorStyle awesome
skinparam packageBackgroundColor #EEF4FF
skinparam packageBorderColor #4A6FA5
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #4A6FA5
skinparam usecaseFontSize 11
skinparam arrowColor #4A6FA5
skinparam actorFontSize 12
skinparam backgroundColor #FFFFFF

actor "Estudiante" as EST
actor "Sistema" as SIS

' ─── Autenticación ───
package "Autenticación" {
  usecase "Registrarse" as UC01
  usecase "Verificar correo (OTP)" as UC02
  usecase "Iniciar sesión" as UC03
  usecase "Recuperar contraseña" as UC04
  usecase "Cerrar sesión" as UC05
}

' ─── Mapa ───
package "Mapa del Campus" {
  usecase "Ver mapa interactivo" as UC06
  usecase "Buscar destino" as UC07
  usecase "Ver ruta al destino" as UC08
  usecase "Ver información de espacio" as UC09
  usecase "Ver plano de evacuación" as UC10
}

' ─── Horario ───
package "Horario" {
  usecase "Crear clase en horario" as UC11
  usecase "Ver horario semanal" as UC12
  usecase "Recibir notificación de clase" as UC13
}

' ─── Social ───
package "Social" {
  usecase "Enviar solicitud de amistad" as UC14
  usecase "Aceptar/Rechazar amistad" as UC15
  usecase "Abrir chat de soporte" as UC16
  usecase "Enviar mensaje con archivo" as UC17
}

' ─── Carnet ───
package "Carnet Digital" {
  usecase "Ver carnet estudiantil" as UC18
  usecase "Mostrar código QR" as UC19
}

' ─── Eventos ───
package "Eventos" {
  usecase "Ver eventos del campus" as UC20
  usecase "Navegar al lugar del evento" as UC21
}

' ─── Oportunidades ───
package "Oportunidades" {
  usecase "Ver oportunidades y becas" as UC22
  usecase "Acceder a inscripción externa" as UC23
}

' ─── Menú ───
package "Menú Cafetería" {
  usecase "Ver menú del día" as UC24
  usecase "Filtrar por tipo de comida" as UC25
}

' ─── Tienda ───
package "Tienda Virtual" {
  usecase "Ver productos disponibles" as UC26
}

' ─── Sistema (automático) ───
package "Acciones del Sistema" {
  usecase "Descargar archivos del mapa" as UC27
  usecase "Persistir sesión" as UC28
  usecase "Enviar notificación push" as UC29
  usecase "Validar dominio de correo" as UC30
}

' ─── Relaciones Estudiante ───
EST --> UC01
EST --> UC03
EST --> UC04
EST --> UC05
EST --> UC06
EST --> UC07
EST --> UC09
EST --> UC10
EST --> UC11
EST --> UC12
EST --> UC14
EST --> UC15
EST --> UC16
EST --> UC17
EST --> UC18
EST --> UC20
EST --> UC21
EST --> UC22
EST --> UC23
EST --> UC24
EST --> UC25
EST --> UC26

' ─── Includes ───
UC01 .> UC02 : <<include>>
UC07 .> UC08 : <<include>>
UC18 .> UC19 : <<include>>
UC03 .> UC27 : <<include>>
UC03 .> UC28 : <<include>>
UC22 .> UC23 : <<include>>
UC24 .> UC25 : <<include>>

' ─── Extends ───
UC08 .> UC21 : <<extend>>
UC11 .> UC13 : <<extend>>
UC16 .> UC17 : <<extend>>

' ─── Sistema ───
SIS --> UC27
SIS --> UC28
SIS --> UC29
SIS --> UC30
UC01 .> UC30 : <<include>>
UC13 .> UC29 : <<include>>

@enduml
