@startuml RoomTracker

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBackgroundColor #EEF4FF
skinparam classBorderColor #4A6FA5
skinparam classFontColor #1a1a1a
skinparam classHeaderBackgroundColor #4A6FA5
skinparam classStereotypeFontColor #ffffff
skinparam arrowColor #4A6FA5
skinparam backgroundColor #FFFFFF
skinparam packageBackgroundColor #F0F4FF
skinparam packageBorderColor #4A6FA5
skinparam packageFontColor #1a1a1a
skinparam packageFontStyle bold
skinparam enumBackgroundColor #FFF3E0
skinparam enumBorderColor #E65100
skinparam enumFontColor #1a1a1a
skinparam enumHeaderBackgroundColor #E65100

package "Autenticación" {

  class USUARIO {
    +id_usuario : UUID <<PK>>
    +nombre : String
    +apellido : String
    +correo : String <<UNIQUE>>
    +contraseña_hash : String
    +datos : JSON
    +estado : Estado
    +fecha_creacion : Timestamp
    +fecha_actualizacion : Timestamp
    +fecha_eliminacion : Timestamp?
    +eliminado_por : UUID?
  }

  enum Estado {
    pendiente
    activo
    inactivo
  }

  class VERIFICACION_CORREO {
    +id_verificacion : UUID <<PK>>
    +id_usuario : UUID <<FK>>
    +codigo_verificacion : String
    +fecha_expiracion : Timestamp
    +verificado : Boolean
  }

  class RECUPERACION_PASSWORD {
    +id_recuperacion : UUID <<PK>>
    +id_usuario : UUID <<FK>>
    +token : String
    +fecha_expiracion : Timestamp
    +usado : Boolean
  }

  class SESION {
    +id_sesion : UUID <<PK>>
    +id_usuario : UUID <<FK>>
    +id_institucion : UUID <<FK>>
    +token : String <<UNIQUE>>
    +fecha_inicio : Timestamp
    +fecha_expiracion : Timestamp
    +activa : Boolean
    +token_fcm : String?
    +plataforma : Plataforma
  }

  enum Plataforma {
    android
    ios
  }

  class CARNET {
    +id_carnet : UUID <<PK>>
    +id_usuario : UUID <<FK>> <<UNIQUE>>
    +id_institucion : UUID <<FK>>
    +codigo_estudiante : String <<UNIQUE>>
    +codigo_qr : String <<UNIQUE>>
    +activo : Boolean
  }

  USUARIO "1" --> "0..*" VERIFICACION_CORREO
  USUARIO "1" --> "0..*" RECUPERACION_PASSWORD
  USUARIO "1" --> "0..*" SESION
  USUARIO "1" --> "1" CARNET
  USUARIO ..> Estado
  SESION ..> Plataforma
}

package "Social" {

  class AMISTAD {
    +id_amistad : UUID <<PK>>
    +id_usuario_1 : UUID <<FK>>
    +id_usuario_2 : UUID <<FK>>
    +estado : EstadoAmistad
    +fecha_creacion : Timestamp
  }

  enum EstadoAmistad {
    pendiente
    aceptada
    bloqueada
  }

  class CHAT {
    +id_chat : UUID <<PK>>
    +id_usuario : UUID <<FK>>
    +id_sesion : UUID <<FK>>
    +contexto_tipo : ContextoChat
  }

  enum ContextoChat {
    soporte
    cafeteria
    biblioteca
  }

  class MENSAJE {
    +id_mensaje : UUID <<PK>>
    +id_chat : UUID <<FK>>
    +id_emisor : UUID <<FK>>
    +tipo : TipoMensaje
    +contenido_texto : String?
    +fecha_envio : Timestamp
  }

  enum TipoMensaje {
    texto
    imagen
    video
  }

  class ARCHIVO {
    +id_archivo : UUID <<PK>>
    +id_mensaje : UUID <<FK>>
    +url : String
    +tipo_mime : String?
    +tamaño : Long?
  }

  AMISTAD ..> EstadoAmistad
  CHAT ..> ContextoChat
  MENSAJE ..> TipoMensaje
  CHAT "1" --> "0..*" MENSAJE
  MENSAJE "1" --> "0..*" ARCHIVO
}

package "Institución" {

  class INSTITUCION {
    +id_institucion : UUID <<PK>>
    +nombre : String
    +dominio_correo : String?
    +es_privada : Boolean
  }

  class EVENTO {
    +id_evento : UUID <<PK>>
    +id_institucion : UUID <<FK>>
    +id_espacio : UUID? <<FK>>
    +titulo : String
    +descripcion : String?
    +imagen_url : String?
    +fecha_inicio : Timestamp
    +fecha_fin : Timestamp
    +tipo : TipoEvento
    +activo : Boolean
  }

  enum TipoEvento {
    charla
    taller
    deportivo
    cultural
    academico
  }

  class OPORTUNIDAD {
    +id_oportunidad : UUID <<PK>>
    +id_institucion : UUID <<FK>>
    +id_creador : UUID <<FK>>
    +titulo : String
    +tipo : TipoOportunidad
    +requisitos : String
    +fecha_cierre : Date
    +url_externa : String?
  }

  enum TipoOportunidad {
    empleo
    practica
    beca
  }

  class PRODUCTO {
    +id_producto : UUID <<PK>>
    +id_institucion : UUID <<FK>>
    +nombre : String
    +descripcion : String?
    +precio : Decimal
    +disponible : Boolean
    +stock : Int?
    +imagen_url : String?
    +activo : Boolean
  }

  EVENTO ..> TipoEvento
  OPORTUNIDAD ..> TipoOportunidad
  INSTITUCION "1" --> "0..*" EVENTO
  INSTITUCION "1" --> "0..*" OPORTUNIDAD
  INSTITUCION "1" --> "0..*" PRODUCTO
}

package "Mapa" {

  class MAP_LAYER {
    +id_layer : UUID <<PK>>
    +id_institucion : UUID <<FK>>
    +nombre : String?
    +tipo : String
    +datos : JSON
    +activo : Boolean
  }

  class MAP_GRAPH {
    +id_grafo : UUID <<PK>>
    +id_institucion : UUID <<FK>>
    +nombre : String?
    +datos : JSON
    +activo : Boolean
  }

  class EDIFICIO {
    +id_edificio : UUID <<PK>>
    +id_nodo : UUID <<FK>>
    +nombre : String
    +descripcion : String?
    +activo : Boolean
    +tipo : TipoEdificio
  }

  enum TipoEdificio {
    agua
    restaurante
    parqueadero
    cancha
    auditorio
    biblioteca
    capilla
    enfermeria
    cafeteria
    edificio
    bus
  }

  class PISO {
    +id_piso : UUID <<PK>>
    +id_edificio : UUID <<FK>>
    +numero : Int
    +nombre : String?
    +plano_emergencia_url : String?
  }

  class ESPACIO {
    +id_espacio : UUID <<PK>>
    +id_piso : UUID <<FK>>
    +id_nodo : UUID?
    +nombre : String
    +descripcion : String?
    +link_externo : String?
  }

  class TIPO_ESPACIO {
    +id_tipo : UUID <<PK>>
    +nombre : String
  }

  class ESPACIO_TIPO {
    +id_espacio : UUID <<PK, FK>>
    +id_tipo : UUID <<PK, FK>>
  }

  class CONTENIDO {
    +id_contenido : UUID <<PK>>
    +id_espacio : UUID <<FK>>
    +tipo : TipoContenido
    +url : String?
    +contenido_texto : String?
    +orden : Int?
  }

  enum TipoContenido {
    imagen
    texto
    video
    link
  }

  class MENU_ITEM {
    +id_item : UUID <<PK>>
    +id_espacio : UUID <<FK>>
    +nombre : String
    +descripcion : String?
    +tipo : TipoMenu
    +precio : Decimal
    +imagen_url : String?
    +dia_semana : String?
  }

  enum TipoMenu {
    desayuno
    almuerzo
    cena
    snack
    bebidas
  }

  EDIFICIO ..> TipoEdificio
  CONTENIDO ..> TipoContenido
  MENU_ITEM ..> TipoMenu
  MAP_GRAPH "1" --> "0..*" EDIFICIO
  EDIFICIO "1" --> "0..*" PISO
  PISO "1" --> "0..*" ESPACIO
  ESPACIO "1" --> "0..*" ESPACIO_TIPO
  ESPACIO_TIPO "0..*" --> "1" TIPO_ESPACIO
  ESPACIO "1" --> "0..*" CONTENIDO
  ESPACIO "1" --> "0..*" MENU_ITEM
  INSTITUCION "1" --> "0..*" MAP_LAYER
  INSTITUCION "1" --> "0..*" MAP_GRAPH
}

package "Horario y Notificaciones" {

  class HORARIO {
    +id_horario : UUID <<PK>>
    +id_usuario : UUID <<FK>>
    +id_espacio : UUID? <<FK>>
    +titulo : String
    +dia_semana : DiaSemana
    +hora_inicio : Time
    +hora_fin : Time
    +imagen_url : String?
    +notificar_antes_min : Int?
    +activo : Boolean
  }

  enum DiaSemana {
    lunes
    martes
    miercoles
    jueves
    viernes
    sabado
  }

  class NOTIFICACION {
    +id_notificacion : UUID <<PK>>
    +id_usuario : UUID <<FK>>
    +id_horario : UUID? <<FK>>
    +titulo : String
    +mensaje : String
    +fecha_programada : Timestamp
    +enviada : Boolean
    +leida : Boolean
  }

  HORARIO ..> DiaSemana
  HORARIO "1" --> "0..*" NOTIFICACION
  USUARIO "1" --> "0..*" HORARIO
  USUARIO "1" --> "0..*" NOTIFICACION
}

' Relaciones inter-paquete
USUARIO "1" --> "0..*" AMISTAD : usuario_1
USUARIO "1" --> "0..*" AMISTAD : usuario_2
USUARIO "1" --> "0..*" CHAT
USUARIO "1" --> "0..*" OPORTUNIDAD : creador
SESION "1" --> "0..*" CHAT
CARNET "0..*" --> "1" INSTITUCION
SESION "0..*" --> "1" INSTITUCION
EVENTO "0..*" --> "0..1" ESPACIO
HORARIO "0..*" --> "0..1" ESPACIO

@enduml
